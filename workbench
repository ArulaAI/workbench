#!/usr/bin/env bash
#
# workbench — canonical Workbench command namespace.
#
# The skill system establishes `workbench <command>` as the platform namespace.
# This is a thin forwarder to the shared implementation currently hosted by the
# `speed` entrypoint; `speed <command>` is retained only as a temporary,
# behaviorally identical alias. Setting WORKBENCH_NS=1 tells the shared commands
# they are running under their canonical name, so no temporary-alias notice is
# printed.
#
# Usage: workbench <init|skills|dashboard|...> [args]

set -euo pipefail

_wb_source="${BASH_SOURCE[0]}"
while [[ -L "$_wb_source" ]]; do
    _wb_dir="$(cd "$(dirname "$_wb_source")" && pwd)"
    _wb_source="$(readlink "$_wb_source")"
    [[ "$_wb_source" != /* ]] && _wb_source="${_wb_dir}/${_wb_source}"
done
_WB_DIR="$(cd "$(dirname "$_wb_source")" && pwd)"

export WORKBENCH_NS=1

# Product skills are intentionally routable without SPEED's heavyweight runtime
# preflight. This adapter contains no authoring logic: the canonical command and
# direct Agent/TUI projection execute the same packaged helper implementation.
# Unrelated ast-grep, model, or dashboard dependencies do not block a
# deterministic interview.
if [[ "${1:-}" == "draft" ]]; then
    shift
    _wb_project_root="${SPEED_PROJECT_ROOT:-$PWD}"
    if [[ -n "${SPEED_PYTHON:-}" ]]; then
        _wb_python="$SPEED_PYTHON"
    elif [[ -x "${_WB_DIR}/.venv/bin/python3" ]]; then
        _wb_python="${_WB_DIR}/.venv/bin/python3"
    elif [[ -x "${_wb_project_root}/.venv/bin/python3" ]]; then
        _wb_python="${_wb_project_root}/.venv/bin/python3"
    else
        _wb_python="python3"
    fi
    exec "$_wb_python" "${_WB_DIR}/skills/workbench-draft/scripts/draft.py" \
        "$@" --project-root "$_wb_project_root"
fi

exec "${_WB_DIR}/speed" "$@"
