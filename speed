# ── Main ─────────────────────────────────────────────────────────

main() {
    local command="${1:-help}"
    shift || true

    # Dependency validation is scoped to the digest command only — see
    # lib/deps.sh's profile table. Must run before dispatch, after the
    # command is known.
    if [[ "$command" == "digest" ]]; then
        speed_check_deps "$command"
    fi

    # ── Extract global flags before dispatching ─────────────────
    GLOBAL_FEATURE=""
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --feature|-f)  GLOBAL_FEATURE="$2"; shift 2 ;;
            --quiet)       VERBOSITY=0; shift ;;
            --verbose)     VERBOSITY=2; shift ;;
            --debug)       VERBOSITY=3; shift ;;
            --json)        JSON_OUTPUT=true; VERBOSITY=0; shift ;;
            *) args+=("$1"); shift ;;
        esac
    done
    set -- "${args[@]+"${args[@]}"}"

    # Track current command for roster and emit heartbeat
    _SPEED_CURRENT_COMMAND="$command"
    [[ "${MP_ENABLED:-}" == "true" ]] && roster_heartbeat

    case "$command" in
        init)      cmd_init "$@" ;;
        validate)  cmd_validate "$@" ;;
        plan)      cmd_plan "$@" ;;
        verify)    cmd_verify "$@" ;;
        run)       cmd_run "$@" ;;
        security)  cmd_security "$@" ;;
        status)    cmd_status "$@" ;;
        defect)    cmd_defect "$@" ;;
        coherence) cmd_coherence "$@" ;;
        integrate) cmd_integrate "$@" ;;
        review)    cmd_review "$@" ;;
        fix-nits)  cmd_fix_nits "$@" ;;
        retry)     cmd_retry "$@" ;;
        recover)   cmd_recover "$@" ;;
        new)       cmd_new "$@" ;;
        guardian)   cmd_guardian "$@" ;;
        audit)     cmd_audit "$@" ;;
        digest)    cmd_digest "$@" ;;
        verify-spec) cmd_verify_spec "$@" ;;
        gates)     cmd_gates "$@" ;;
        clean)     cmd_clean "$@" ;;
        add-language) cmd_add_language "$@" ;;
        test-rules)   cmd_test_rules "$@" ;;
        learn)     cmd_learn "$@" ;;
        mp-init)        cmd_mp_init "$@" ;;
        rebuild-state)  cmd_rebuild_state "$@" ;;
        claim)          cmd_claim "$@" ;;
        release)        cmd_release "$@" ;;
        whoami)         echo "$(actor_get) ($(actor_slug))" ;;
        spec)           cmd_spec "$@" ;;
        review-request) cmd_review_request "$@" ;;
        review-judge)   cmd_review_judge "$@" ;;
        review-status)  cmd_review_status "$@" ;;
        sync)           cmd_sync "$@" ;;
        serve)          cmd_serve "$@" ;;
        dashboard) cmd_dashboard "$@" ;;
        self-update)   cmd_self_update "$@" ;;
        self-uninstall) cmd_self_uninstall "$@" ;;
        help|--help|-h) speed_help ;;
        *)
            log_error "Unknown command: ${command}"
            speed_help
            exit 1
            ;;
    esac
}

main "$@"
