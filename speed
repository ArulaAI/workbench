#!/usr/bin/env bash
#
# speed — SPEED orchestration CLI for autonomous product development
#
# Usage: speed <command> [options]
#
# Commands:
#   init                    Initialize project for SPEED development
#   validate <specs-dir>    Cross-validate all specs for consistency
#   plan <spec-file> [opts] Decompose a spec into a task DAG + contract
#   verify                  Blind-verify the plan against the product spec
#   run [options]           Execute pending tasks with parallel agents
#   status                  Show SPEED state and progress
#   coherence [--resolve]    Check cross-task consistency before integration
#   integrate               Merge completed branches into main
#   review [--task-id ID]   Run code review on completed tasks
#   defect <spec-file>      Run full defect pipeline (triage → fix → review)
#   learn [options]         Extract observations and discover conventions
#   security                Run security audit on completed task diffs
#   fix-nits [--task-id ID] Create a task to fix reviewer nits
#   retry --task-id ID      Retry a failed task with human guidance
#   recover                 Recover from crashed/stale state
#   guardian [spec-file]     Run Product Guardian vision check
#   audit <spec-file>       Audit a spec for structural completeness
#   add-language <lang>     Generate ast-grep rules for a new language
#   test-rules [lang|--all] Verify ast-grep rules against fixtures
#   dashboard [start|stop]  Launch SPEED dashboard
#   self-update             Update SPEED to the latest version
#   self-uninstall          Remove SPEED and clean up shell config
#   help                    Show this help message

set -euo pipefail

# ── Bootstrap ────────────────────────────────────────────────────
# Resolve through symlinks so SCRIPT_DIR points to the real location
# even when invoked via ~/.speed/bin/speed -> ../current/speed
_speed_source="${BASH_SOURCE[0]}"
while [[ -L "$_speed_source" ]]; do
    _speed_link_dir="$(cd "$(dirname "$_speed_source")" && pwd)"
    _speed_source="$(readlink "$_speed_source")"
    # Handle relative symlinks
    [[ "$_speed_source" != /* ]] && _speed_source="${_speed_link_dir}/${_speed_source}"
done
SCRIPT_DIR="$(cd "$(dirname "$_speed_source")" && pwd)"
unset _speed_source _speed_link_dir
export SPEED_CMD="${SCRIPT_DIR}/speed"

source "${SCRIPT_DIR}/lib/config.sh"
source "${SCRIPT_DIR}/lib/log.sh"
source "${SCRIPT_DIR}/lib/deps.sh"
source "${SCRIPT_DIR}/lib/cleanup.sh"
source "${SCRIPT_DIR}/lib/progress.sh"
source "${SCRIPT_DIR}/lib/git.sh"
source "${SCRIPT_DIR}/lib/provider.sh"
source "${SCRIPT_DIR}/lib/tasks.sh"
source "${SCRIPT_DIR}/lib/grounding.sh"
source "${SCRIPT_DIR}/lib/gates.sh"
source "${SCRIPT_DIR}/lib/lock.sh"
source "${SCRIPT_DIR}/lib/features.sh"
source "${SCRIPT_DIR}/lib/actor.sh"
source "${SCRIPT_DIR}/lib/multiplayer.sh"
source "${SCRIPT_DIR}/lib/events.sh"
source "${SCRIPT_DIR}/lib/ownership.sh"
source "${SCRIPT_DIR}/lib/roster.sh"
source "${SCRIPT_DIR}/lib/context_bridge.sh"
source "${SCRIPT_DIR}/lib/security.sh"
source "${SCRIPT_DIR}/lib/learn_bridge.sh"
source "${SCRIPT_DIR}/lib/defects.sh"
source "${SCRIPT_DIR}/lib/defect_triage.sh"
[[ -f "${SCRIPT_DIR}/lib/defect_fix.sh" ]] && source "${SCRIPT_DIR}/lib/defect_fix.sh"
[[ -f "${SCRIPT_DIR}/lib/defect_review.sh" ]] && source "${SCRIPT_DIR}/lib/defect_review.sh"

# ── Multi-player detection ──────────────────────────────────────
MP_ENABLED=""
if mp_is_enabled; then
    MP_ENABLED=true
fi

source "${SCRIPT_DIR}/lib/shared.sh"

# ── Command modules ─────────────────────────────────────────
for _cmd_file in "${SCRIPT_DIR}"/lib/cmd/*.sh; do
    [[ -f "$_cmd_file" ]] && source "$_cmd_file"
done
unset _cmd_file

# ── Cleanup trap ─────────────────────────────────────────────
# Kill orphaned agent processes and remove temp files on exit/interrupt.
trap cleanup_all EXIT INT TERM

# ── Helpers ──────────────────────────────────────────────────────

