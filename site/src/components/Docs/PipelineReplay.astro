---
// PipelineReplay.astro
// Interactive animated walkthrough of a real SPEED pipeline run (F9: Profile Completeness).
// Self-contained: all styles scoped under .pipeline-replay, client-side JS for animation.
---

<div class="pipeline-replay">
  <div class="pr-terminal">
    <div class="pr-dots"><span></span><span></span><span></span></div>
    <div class="pr-scene" id="pr-sc"></div>
  </div>

  <div class="pr-controls">
    <button class="pr-play-btn" id="pr-play-btn" aria-label="Play">
      <svg id="pr-pause-icon" viewBox="0 0 24 24" fill="currentColor" style="display:none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
      <svg id="pr-play-icon" viewBox="0 0 24 24" fill="currentColor"><polygon points="6,4 20,12 6,20"/></svg>
    </button>
    <div class="pr-track">
      <div class="pr-bar" id="pr-bar"></div>
      <div class="pr-labels" id="pr-labels"></div>
    </div>
    <div class="pr-counter" id="pr-counter"></div>
  </div>

  <div class="pr-hint">
    <kbd>Space</kbd> pause/play &nbsp; <kbd>&larr;</kbd> <kbd>&rarr;</kbd> navigate
  </div>
</div>

<style is:global>
.pipeline-replay {
  --pr-bg: #1a1a1e;
  --pr-elevated: #232328;
  --pr-card: #303034;
  --pr-text: #e4e4e9;
  --pr-dim: #58585e;
  --pr-mid: #a0a0a8;
  --pr-accent: #00ccaa;
  --pr-warn: #e8a87c;
  --pr-err: #ef4444;
  --pr-gate: #1a3a35;
  --pr-mono: 'IBM Plex Mono', ui-monospace, monospace;

  width: 100%;
  max-width: 820px;
  margin: 2rem auto;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  font-family: var(--pr-mono);
  font-size: 13px;
  line-height: 1.6;
  color: var(--pr-text);
  -webkit-font-smoothing: antialiased;
}

/* Terminal */
.pr-terminal {
  background: var(--pr-elevated);
  border-radius: 12px;
  padding: 2rem 2.5rem;
  min-height: 500px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(0,0,0,0.4), 0 0 0 1px rgba(0,204,170,0.06);
}
.pr-dots { position: absolute; top: 1rem; left: 1.25rem; display: flex; gap: 6px; }
.pr-dots span { width: 10px; height: 10px; border-radius: 50%; }
.pr-dots span:nth-child(1) { background: var(--pr-err); opacity: 0.6; }
.pr-dots span:nth-child(2) { background: var(--pr-warn); opacity: 0.6; }
.pr-dots span:nth-child(3) { background: var(--pr-accent); opacity: 0.6; }

.pr-scene { padding-top: 0.75rem; min-height: 440px; display: flex; flex-direction: column; }
.pr-scene.fade-out { animation: prFadeOut 200ms ease forwards; }
.pr-scene.fade-in  { animation: prFadeIn 200ms ease forwards; }
@keyframes prFadeOut { to { opacity: 0; } }
@keyframes prFadeIn  { from { opacity: 0; } to { opacity: 1; } }

/* Stage banner */
.pr-banner { display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 1.25rem; opacity: 0; transition: opacity 200ms ease; }
.pr-banner.visible { opacity: 1; }
.pr-banner-name { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--pr-accent); }
.pr-banner-rule { flex: 1; height: 1px; background: rgba(0,204,170,0.15); }
.pr-banner-num { font-size: 0.75rem; color: var(--pr-dim); }

/* Agent badge */
.pr-badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.75rem; border: 1px solid rgba(0,204,170,0.15); border-radius: 6px; font-size: 0.8rem; font-weight: 500; color: var(--pr-text); background: var(--pr-gate); margin-bottom: 0.5rem; opacity: 0; transform: translateY(4px); transition: opacity 200ms ease, transform 200ms ease; }
.pr-badge.visible { opacity: 1; transform: translateY(0); }
.pr-badge .pr-mult { color: var(--pr-dim); font-size: 0.75rem; }
.pr-badge .pr-wave { color: var(--pr-dim); font-size: 0.75rem; margin-left: 0.25rem; }

/* Content */
.pr-step { opacity: 0; transition: opacity 200ms ease; }
.pr-step.visible { opacity: 1; }
.pr-line { color: var(--pr-mid); padding-left: 0.25rem; white-space: pre-wrap; font-size: 13px; line-height: 1.65; }
.pr-line.bright { color: var(--pr-text); }
.pr-line.dim { color: var(--pr-dim); }
.pr-line.pass { color: var(--pr-accent); }
.pr-line.warn { color: var(--pr-warn); }
.pr-line.err { color: var(--pr-err); }

/* Callout */
.pr-callout { margin: 0.6rem 0; padding: 0.6rem 1rem; background: rgba(0,204,170,0.03); border-left: 2px solid rgba(0,204,170,0.15); border-radius: 0 6px 6px 0; opacity: 0; transition: opacity 250ms ease; }
.pr-callout.visible { opacity: 1; }
.pr-callout.warn-border { border-left-color: var(--pr-warn); }
.pr-callout.pass-border { border-left-color: var(--pr-accent); }
.pr-callout.err-border { border-left-color: var(--pr-err); }
.pr-callout.accent-border { border-left-color: var(--pr-accent); }
.pr-callout-label { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--pr-dim); margin-bottom: 0.3rem; }
.pr-callout-body { font-size: 12.5px; color: var(--pr-mid); line-height: 1.6; white-space: pre-wrap; }
.pr-callout-source { font-size: 11px; color: var(--pr-dim); margin-top: 0.35rem; font-style: italic; }

/* Wave row */
.pr-waverow { display: flex; align-items: baseline; gap: 0.5rem; padding: 0.15rem 0; font-size: 13px; color: var(--pr-mid); }
.pr-waverow .pr-tid { color: var(--pr-accent); min-width: 2rem; font-weight: 500; }
.pr-waverow .pr-files { flex: 1; color: var(--pr-mid); }
.pr-waverow .pr-time { color: var(--pr-dim); text-align: right; min-width: 4rem; }

/* Spacer */
.pr-sp { height: 0.6rem; }
.pr-sp-lg { height: 1rem; }

/* Connector */
.pr-conn { padding: 0.25rem 0 0.25rem 1.5rem; color: var(--pr-dim); font-size: 12px; opacity: 0; transition: opacity 200ms ease; }
.pr-conn.visible { opacity: 1; }

/* Title block */
.pr-title { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 400px; text-align: center; gap: 0.5rem; }
.pr-title .pr-t1 { font-size: 1.5rem; font-weight: 700; color: var(--pr-accent); letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem; }
.pr-title .pr-t2 { font-size: 1.4rem; font-weight: 600; color: var(--pr-text); }
.pr-title .pr-t3 { font-size: 0.85rem; color: var(--pr-dim); max-width: 380px; line-height: 1.5; }
.pr-title .pr-t4 { font-size: 0.85rem; color: var(--pr-mid); margin-top: 1.5rem; }

/* Summary */
.pr-summary { margin: 0.75rem auto; padding: 1rem 1.5rem; border: 1px solid rgba(0,204,170,0.15); border-radius: 8px; background: var(--pr-gate); display: inline-block; }
.pr-summary .pr-sline { color: var(--pr-mid); white-space: pre-wrap; font-size: 13px; line-height: 1.8; }

/* Spinner */
.pr-spin { color: var(--pr-dim); font-size: 13px; padding-left: 0.25rem; transition: opacity 300ms ease; }
.pr-spin .pr-sc { color: var(--pr-accent); margin-right: 0.4rem; }

/* Controls */
.pr-controls { display: flex; align-items: center; gap: 0.75rem; }
.pr-play-btn { background: none; border: 1px solid rgba(0,204,170,0.15); border-radius: 6px; color: var(--pr-dim); width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 150ms ease; flex-shrink: 0; }
.pr-play-btn:hover { border-color: var(--pr-accent); color: var(--pr-accent); }
.pr-play-btn svg { width: 13px; height: 13px; }

.pr-track { flex: 1; display: flex; flex-direction: column; gap: 6px; }
.pr-bar { display: flex; gap: 3px; height: 4px; }
.pr-seg { flex: 1; background: rgba(255,255,255,0.06); border-radius: 2px; cursor: pointer; transition: background 300ms ease, box-shadow 300ms ease; }
.pr-seg.completed { background: var(--pr-accent); opacity: 0.6; }
.pr-seg.active { background: var(--pr-accent); box-shadow: 0 0 8px rgba(0,204,170,0.4); }
.pr-seg:hover { background: rgba(0,204,170,0.3); }
.pr-seg.completed:hover, .pr-seg.active:hover { background: var(--pr-accent); opacity: 1; }

.pr-labels { display: flex; gap: 3px; }
.pr-lbl { flex: 1; font-size: 0.55rem; letter-spacing: 0.04em; text-transform: uppercase; text-align: center; color: var(--pr-dim); cursor: pointer; transition: color 200ms ease; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pr-lbl.completed { color: var(--pr-mid); }
.pr-lbl.active { color: var(--pr-accent); font-weight: 600; }

.pr-counter { font-size: 0.75rem; color: var(--pr-dim); white-space: nowrap; min-width: 3rem; text-align: right; }

.pr-hint { font-size: 0.72rem; color: var(--pr-dim); text-align: center; opacity: 0.4; }
.pr-hint kbd { display: inline-block; padding: 0.1em 0.35em; font-family: var(--pr-mono); font-size: 0.65rem; background: rgba(0,204,170,0.08); border-radius: 3px; margin: 0 0.1em; }
</style>

<script>
const SPIN = ['\u280b','\u2819','\u2839','\u2838','\u283c','\u2834','\u2826','\u2827','\u2807','\u280f'];
const SPIN_MS = 80;

const sc = document.getElementById('pr-sc');
const bar = document.getElementById('pr-bar');
const labels = document.getElementById('pr-labels');
const counter = document.getElementById('pr-counter');
const playBtn = document.getElementById('pr-play-btn');
const pauseIcon = document.getElementById('pr-pause-icon');
const playIcon = document.getElementById('pr-play-icon');

let cur = 0, paused = true, timeouts = [], intervals = [];

function sched(fn, ms) { const t = setTimeout(fn, ms); timeouts.push(t); return t; }
function schedIv(fn, ms) { const i = setInterval(fn, ms); intervals.push(i); return i; }
function clearAll() { timeouts.forEach(t => clearTimeout(t)); timeouts = []; intervals.forEach(i => clearInterval(i)); intervals = []; }

function el(tag, cls, text) { const e = document.createElement(tag); if (cls) e.className = cls; if (text !== undefined) e.textContent = text; return e; }
function addTo(p, tag, cls, text) { const e = el(tag, cls, text); p.appendChild(e); return e; }

function makeBanner(name, num, total) { const b = el('div','pr-banner'); addTo(b,'span','pr-banner-name',name); addTo(b,'span','pr-banner-rule'); addTo(b,'span','pr-banner-num',`stage ${num} of ${total}`); return b; }

function robotSvg() {
  const s = document.createElementNS('http://www.w3.org/2000/svg','svg');
  s.setAttribute('viewBox','0 0 16 16'); s.setAttribute('width','14'); s.setAttribute('height','14'); s.style.flexShrink='0';
  s.innerHTML='<rect x="3" y="5" width="10" height="9" rx="2" fill="#80f0d8"/><line x1="8" y1="5" x2="8" y2="2" stroke="#80f0d8" stroke-width="1.5"/><circle cx="8" cy="1.5" r="1.5" fill="#80f0d8"/><circle cx="6" cy="9" r="1.2" fill="#1a3a35"/><circle cx="10" cy="9" r="1.2" fill="#1a3a35"/><rect x="5.5" y="11.5" width="5" height="1" rx="0.5" fill="#1a3a35"/>';
  return s;
}

function makeBadge(name, extra) { const b=el('div','pr-badge'); b.appendChild(robotSvg()); addTo(b,'span','',name); if(extra) addTo(b,'span','pr-mult',extra); return b; }
function makeBadgeW(name, mult, wave) { const b=el('div','pr-badge'); b.appendChild(robotSvg()); addTo(b,'span','',name); if(mult) addTo(b,'span','pr-mult',mult); if(wave) addTo(b,'span','pr-wave',wave); return b; }
function makeLine(t,c) { return el('div',`pr-step pr-line ${c||''}`,t); }
function makeCallout(label,body,src,bc) { const c=el('div',`pr-callout ${bc||''}`); if(label) addTo(c,'div','pr-callout-label',label); addTo(c,'div','pr-callout-body',body); if(src) addTo(c,'div','pr-callout-source',src); return c; }
function makeConn(t) { return el('div','pr-conn',t||'\u2193'); }
function sp(lg) { return el('div',lg?'pr-sp-lg':'pr-sp'); }
function waveRow(id,f,t) { const r=el('div','pr-step pr-waverow'); addTo(r,'span','pr-tid',`T${id}`); addTo(r,'span','pr-files',f); addTo(r,'span','pr-time',t); return r; }

const LABELS = ['Intro','Validate','Plan','Verify','Run','Review','Coherence','Integrate','Summary'];

function sceneTitle() {
  const w=el('div','pr-title');
  const a=addTo(w,'div','pr-t1','SPEED Pipeline Replay');
  const b=addTo(w,'div','pr-t2','F9: Profile Completeness');
  const c=addTo(w,'div','pr-t3','Show builders how complete their profile is.');
  const d=addTo(w,'div','pr-t4','3 specs  \u2192  7 tasks  \u2192  1 feature  \u2192  18 minutes');
  [a,b,c,d].forEach(x=>{x.style.opacity='0';x.style.transition='opacity 400ms ease';});
  return [{el:w,delay:0,onShow:()=>{[a,b,c,d].forEach((x,i)=>sched(()=>x.style.opacity='1',i*500));}}];
}

function sceneValidate() {
  return [
    {el:makeBanner('Validate',1,7),delay:0,cls:'pr-banner'},
    {el:sp(),delay:200},{el:makeBadge('Deterministic'),delay:300,cls:'pr-badge'},
    {el:makeLine('Cross-referenced 3 specs for contradictions and gaps.'),delay:300},
    {el:sp(),delay:200},
    {el:makeLine('product/f9-profile-completeness.md    4 user stories, 4 success criteria','dim'),delay:200},
    {el:makeLine('tech/f9-profile-completeness.md       6 data fields, 2 API fields, 4 decisions','dim'),delay:200},
    {el:makeLine('design/f9-profile-completeness.md     3 components, 19 tokens, 5 states','dim'),delay:200},
    {el:sp(true),delay:400},
    {el:makeLine('\u2713 No contradictions','pass'),delay:300},
    {el:makeLine('\u2713 No missing dependencies','pass'),delay:200},
    {el:makeLine('\u2713 All acceptance criteria machine-verifiable','pass'),delay:200},
  ];
}

function scenePlan() {
  return [
    {el:makeBanner('Plan',2,7),delay:0,cls:'pr-banner'},
    {el:sp(),delay:200},{el:makeBadge('Product Guardian'),delay:300,cls:'pr-badge'},
    {el:makeLine('Analyzed spec against product vision and 4 personas.'),delay:200},
    {el:sp(),delay:300},
    {el:makeCallout('Flagged','profileCompleteness exposed on all UserType\ninstances with no auth gating.\n\nPRD: "completeness visible to other users\nis out of scope \u2014 leaks private information"','specs/product/f9-profile-completeness.md \u00b7 Scope section','warn-border'),delay:400},
    {el:sp(),delay:300},
    {el:makeLine('\u2713 Mission-aligned \u00b7 4 personas served','pass'),delay:200},
    {el:makeLine('\u2713 Feeds Activation KPI \u00b7 70% completion target','pass'),delay:200},
    {el:sp(true),delay:500},{el:makeConn('then \u2193'),delay:200},{el:sp(),delay:200},
    {el:makeBadge('Architect'),delay:300,cls:'pr-badge'},
    {el:makeLine('Decomposed spec into task DAG with per-task acceptance criteria.'),delay:200},
    {el:sp(),delay:300},
    {el:makeLine('7 tasks \u00b7 3 waves \u00b7 max concurrency 3','bright'),delay:300},
    {el:sp(),delay:200},
    {el:makeLine('Wave 1    T1 Backend resolvers   T2 GraphQL types   T3 Ring component','dim'),delay:200},
    {el:makeLine('Wave 2    T4 Section (\u2192 T3)     T5 Nudge (\u2192 T3)','dim'),delay:200},
    {el:makeLine('Wave 3    T6 Settings (\u2192 T2,T4)  T7 Profile (\u2192 T2,T5)','dim'),delay:200},
    {el:sp(),delay:200},
    {el:makeLine('contract: 6 entities \u00b7 2 core queries','dim'),delay:200},
  ];
}

function sceneVerify() {
  return [
    {el:makeBanner('Verify',3,7),delay:0,cls:'pr-banner'},
    {el:sp(),delay:200},{el:makeBadge('Plan Verifier'),delay:300,cls:'pr-badge'},
    {el:makeLine('Blind audit of the plan. No access to the Architect\u2019s reasoning.'),delay:200},
    {el:sp(),delay:200},
    {el:null,delay:1500,spinner:true,spinText:'Checking 15 requirements against task coverage\u2026'},
    {el:sp(),delay:200},
    {el:makeLine('15 spec requirements checked','bright'),delay:200},
    {el:makeLine('15 covered \u00b7 0 gaps \u00b7 0 critical failures','pass'),delay:300},
    {el:sp(),delay:300},
    {el:makeLine('PC-1  Settings page percentage       \u2192  T3, T4, T6   \u2713','dim'),delay:250},
    {el:makeLine('PC-2  Missing fields with links      \u2192  T4, T6       \u2713','dim'),delay:200},
    {el:makeLine('PC-3  Real-time update after save    \u2192  T6           \u2713','dim'),delay:200},
    {el:makeLine('PC-4  Profile page nudge             \u2192  T5, T7       \u2713','dim'),delay:200},
    {el:sp(true),delay:400},
    {el:makeLine('verdict: pass \u00b7 no semantic drift','pass'),delay:300},
  ];
}

function sceneRun() {
  return [
    {el:makeBanner('Run',4,7),delay:0,cls:'pr-banner'},
    {el:sp(),delay:200},
    {el:makeLine('7 developer agents. 3 waves. Isolated git worktrees.'),delay:200},
    {el:sp(true),delay:400},
    {el:makeBadgeW('Developer','\u00d7 3','Wave 1 \u00b7 6m 16s'),delay:300,cls:'pr-badge'},
    {el:waveRow(1,'score_service.py, user.py, test_score_service.py','6m 16s'),delay:200},
    {el:waveRow(2,'types.ts, builders.ts','2m 09s'),delay:150},
    {el:waveRow(3,'completeness-ring.tsx, completeness-ring.test.tsx','4m 05s'),delay:150},
    {el:sp(true),delay:400},
    {el:makeBadgeW('Developer','\u00d7 2','Wave 2 \u00b7 3m 57s'),delay:300,cls:'pr-badge'},
    {el:waveRow(4,'completeness-section.tsx, completeness-section.test.tsx','3m 33s'),delay:200},
    {el:waveRow(5,'completeness-nudge.tsx, completeness-nudge.test.tsx','3m 57s'),delay:150},
    {el:sp(true),delay:400},
    {el:makeBadgeW('Developer','\u00d7 2','Wave 3 \u00b7 6m 51s'),delay:300,cls:'pr-badge'},
    {el:waveRow(6,'settings/page.tsx, settings/page.test.tsx','6m 51s'),delay:200},
    {el:waveRow(7,'profile-content.tsx, profile-content.test.tsx','3m 57s'),delay:150},
    {el:sp(true),delay:600},
    {el:makeLine('lint \u2713   typecheck \u2713   tests \u2713 1,170 pass','pass'),delay:300},
    {el:sp(),delay:200},
    {el:makeLine('Wall clock: 18m 15s \u00b7 Agent time: 30m 47s \u00b7 1.7\u00d7 parallelism','dim'),delay:300},
  ];
}

function sceneReview() {
  return [
    {el:makeBanner('Review',5,7),delay:0,cls:'pr-banner'},
    {el:sp(),delay:200},{el:makeBadge('Reviewer','\u00d7 7'),delay:300,cls:'pr-badge'},
    {el:makeLine('Each diff audited against the original spec, not the task description.'),delay:200},
    {el:sp(),delay:300},
    {el:makeLine('T1 \u2717  T2 \u2713  T3 \u2713  T4 \u2717  T5 \u2713  T6 \u2713  T7 \u2713     5 approved \u00b7 2 flagged','bright'),delay:400},
    {el:sp(true),delay:800},
    {el:makeCallout('Spec requirement','"A shared constant list ensures [score_service\nand UserType resolvers] stay in sync"','specs/tech/f9-profile-completeness.md \u00b7 Key Decisions','accent-border'),delay:400},
    {el:sp(),delay:500},
    {el:makeCallout('What the reviewer found','score_service.py    bool(getattr(user, attr))\nuser.py             str(value).strip() == ""\n\nheadline = "   "\n\nscore_service    bool("   ")    \u2192  True    filled\nuser.py          "   ".strip()  \u2192  ""      empty\n\nSame data. Different answers.','review-1.json \u00b7 14 spec checks \u00b7 19KB analysis','err-border'),delay:500},
    {el:sp(),delay:400},
    {el:makeLine('Fix: move _field_filled into score_service.py as single source of truth.','dim'),delay:300},
    {el:sp(true),delay:800},
    {el:makeCallout('Design spec token table','Hollow bullet \u2502 text-ink-tertiary \u2502 #a8a29e','specs/design/f9-profile-completeness.md','accent-border'),delay:400},
    {el:sp(),delay:400},
    {el:makeCallout('What shipped','Hollow bullet inherits text-accent (#6366f1)\nfrom parent <button>. No explicit color class.\n\nVisual hierarchy collapsed \u2014 bullet competes\nwith label text instead of receding.','review-4.json \u00b7 10 spec checks','err-border'),delay:500},
    {el:sp(),delay:400},
    {el:makeLine('Fix: <span className="text-ink-tertiary">\u25cb</span>','dim'),delay:300},
    {el:sp(true),delay:600},
    {el:makeLine('Both tasks re-run. Feedback addressed autonomously.','pass'),delay:400},
  ];
}

function sceneCoherence() {
  return [
    {el:makeBanner('Coherence',6,7),delay:0,cls:'pr-banner'},
    {el:sp(),delay:200},{el:makeBadge('Coherence Checker'),delay:300,cls:'pr-badge'},
    {el:makeLine('Verified cross-branch compatibility across all 7 task outputs.'),delay:200},
    {el:sp(),delay:200},
    {el:null,delay:1800,spinner:true,spinText:'Tracing data flow across 7 branches\u2026'},
    {el:sp(),delay:200},
    {el:makeCallout('Entity trace: spec \u2192 shipped code','COMPLETENESS_FIELDS\n  \u2192  score_service.py:14       dict, 6 fields\n  \u2192  user.py:47                resolver import\n  \u2192  test_score_service.py:22   length assertion\n\nprofileCompleteness: Float!\n  \u2192  user.py:51                @strawberry.field\n  \u2192  types.ts:38               TypeScript type\n  \u2192  builders.ts:12            GET_BUILDER query\n  \u2192  completeness-ring.tsx     visual render\n  \u2192  settings/page.tsx         page integration\n  \u2192  profile-content.tsx       page integration','contract.json \u00b7 6 entities \u00b7 2 core queries','pass-border'),delay:400},
    {el:sp(true),delay:400},
    {el:makeLine('0 interface mismatches \u00b7 0 duplicates \u00b7 0 orphaned code','pass'),delay:300},
  ];
}

function sceneIntegrate() {
  return [
    {el:makeBanner('Integrate',7,7),delay:0,cls:'pr-banner'},
    {el:sp(),delay:200},{el:makeBadge('Integrator'),delay:300,cls:'pr-badge'},
    {el:makeLine('Merged branches in dependency order. Ran regression tests.'),delay:200},
    {el:sp(),delay:200},
    {el:null,delay:1500,spinner:true,spinText:'Merging 7 branches into main\u2026'},
    {el:makeLine('7 branches merged \u00b7 0 conflicts','pass'),delay:300},
    {el:makeLine('Backend    30 tests pass','pass'),delay:200},
    {el:makeLine('Frontend   1,140 tests pass','pass'),delay:200},
    {el:sp(true),delay:500},{el:makeConn('then \u2193'),delay:200},{el:sp(),delay:200},
    {el:makeBadge('Product Guardian'),delay:300,cls:'pr-badge'},
    {el:makeLine('Final product gate against original spec.'),delay:200},
    {el:sp(),delay:300},
    {el:makeLine('\u2713 aligned \u00b7 no vision drift','pass'),delay:400},
  ];
}

function sceneSummary() {
  const w=el('div',''); w.style.textAlign='center'; w.style.paddingTop='2rem';
  const h=addTo(w,'div',''); h.style.fontSize='1.4rem'; h.style.fontWeight='700'; h.style.color='var(--pr-accent)'; h.style.letterSpacing='0.04em'; h.style.marginBottom='1.5rem'; h.textContent='Feature shipped.'; h.style.opacity='0'; h.style.transition='opacity 400ms ease';
  const box=addTo(w,'div','pr-summary');
  const lines=['3 specs written','7 tasks executed in 3 parallel waves','2 bugs caught by spec-driven review','1,170 tests passing','0 manual intervention needed','18 minutes wall clock'];
  const lEls=lines.map(t=>{const l=addTo(box,'div','pr-sline',t);l.style.opacity='0';l.style.transition='opacity 300ms ease';return l;});
  const foot=addTo(w,'div','pr-line dim'); foot.style.marginTop='1.5rem'; foot.textContent='validate \u2192 plan \u2192 verify \u2192 run \u2192 review \u2192 coherence \u2192 integrate'; foot.style.opacity='0'; foot.style.transition='opacity 400ms ease';
  return [{el:w,delay:0,onShow:()=>{sched(()=>h.style.opacity='1',300);lEls.forEach((l,i)=>sched(()=>l.style.opacity='1',800+i*200));sched(()=>foot.style.opacity='1',800+lines.length*200+400);}}];
}

const SCENES=[
  {title:'Intro',duration:5000,build:sceneTitle},
  {title:'Validate',duration:8000,build:sceneValidate},
  {title:'Plan',duration:18000,build:scenePlan},
  {title:'Verify',duration:12000,build:sceneVerify},
  {title:'Run',duration:18000,build:sceneRun},
  {title:'Review',duration:28000,build:sceneReview},
  {title:'Coherence',duration:14000,build:sceneCoherence},
  {title:'Integrate',duration:14000,build:sceneIntegrate},
  {title:'Summary',duration:10000,build:sceneSummary},
];

LABELS.forEach((label,i)=>{
  const seg=el('div','pr-seg'); seg.addEventListener('click',()=>jumpTo(i)); seg.title=label; bar.appendChild(seg);
  const lbl=el('div','pr-lbl',label); lbl.addEventListener('click',()=>jumpTo(i)); labels.appendChild(lbl);
});

function updateProgress(){
  const segs=bar.children, lbls=labels.children;
  for(let i=0;i<segs.length;i++){
    segs[i].className='pr-seg'; lbls[i].className='pr-lbl';
    if(i<cur){segs[i].classList.add('completed');lbls[i].classList.add('completed');}
    if(i===cur){segs[i].classList.add('active');lbls[i].classList.add('active');}
  }
  counter.textContent=`${cur+1}/${SCENES.length}`;
}

function updatePlayBtn(){pauseIcon.style.display=paused?'none':'block';playIcon.style.display=paused?'block':'none';}

function playScene(index){
  clearAll(); cur=index; sc.innerHTML=''; sc.classList.remove('fade-out','fade-in'); updateProgress();
  const steps=SCENES[index].build(); let cum=0;
  steps.forEach(step=>{
    cum+=step.delay; const d=cum;
    if(step.spinner){
      const spinLine=el('div','pr-spin'), spinChar=el('span','pr-sc',SPIN[0]);
      spinLine.appendChild(spinChar); spinLine.appendChild(document.createTextNode(step.spinText)); sc.appendChild(spinLine);
      sched(()=>{let f=0;const iv=schedIv(()=>{f=(f+1)%SPIN.length;spinChar.textContent=SPIN[f];},SPIN_MS);sched(()=>{clearInterval(iv);spinLine.style.opacity='0';sched(()=>spinLine.remove(),300);},step.delay);},d);
      cum+=step.delay+300; return;
    }
    if(!step.el) return;
    sched(()=>{
      sc.appendChild(step.el);
      if(step.cls==='pr-banner'||step.cls==='pr-badge') requestAnimationFrame(()=>step.el.classList.add('visible'));
      else if(step.el.classList.contains('pr-callout')||step.el.classList.contains('pr-step')||step.el.classList.contains('pr-conn')) requestAnimationFrame(()=>step.el.classList.add('visible'));
      else step.el.style.opacity='1';
      if(step.onShow) step.onShow();
    },d);
  });
  sched(()=>{if(index<SCENES.length-1)transitionTo(index+1);},SCENES[index].duration);
}

function renderInstant(index){
  clearAll(); cur=index; sc.innerHTML=''; sc.classList.remove('fade-out','fade-in'); updateProgress();
  const steps=SCENES[index].build();
  steps.forEach(step=>{
    if(step.spinner||!step.el) return; sc.appendChild(step.el);
    if(step.cls==='pr-banner'||step.cls==='pr-badge') step.el.classList.add('visible');
    else if(step.el.classList.contains('pr-callout')||step.el.classList.contains('pr-step')||step.el.classList.contains('pr-conn')) step.el.classList.add('visible');
    else step.el.style.opacity='1';
    if(step.onShow) step.el.querySelectorAll('*').forEach(c=>{if(c.style.opacity==='0')c.style.opacity='1';});
  });
}

function transitionTo(index){clearAll();sc.classList.add('fade-out');sched(()=>{sc.classList.remove('fade-out');sc.classList.add('fade-in');playScene(index);sched(()=>sc.classList.remove('fade-in'),200);},200);}
function jumpTo(index){if(index<0||index>=SCENES.length)return;if(paused)renderInstant(index);else transitionTo(index);}
function togglePause(){if(paused){paused=false;updatePlayBtn();playScene(cur);}else{paused=true;updatePlayBtn();clearAll();renderInstant(cur);}}

playBtn.addEventListener('click',togglePause);
document.addEventListener('keydown',e=>{
  if(e.key===' '||e.code==='Space'){e.preventDefault();togglePause();}
  else if(e.key==='ArrowRight'){e.preventDefault();if(cur<SCENES.length-1)jumpTo(cur+1);}
  else if(e.key==='ArrowLeft'){e.preventDefault();if(cur>0)jumpTo(cur-1);}
});

let hasAutoPlayed=false;
const observer=new IntersectionObserver(entries=>{
  entries.forEach(entry=>{if(entry.isIntersecting&&!hasAutoPlayed){hasAutoPlayed=true;paused=false;updatePlayBtn();playScene(0);}});
},{threshold:0.3});
observer.observe(document.querySelector('.pr-terminal'));

renderInstant(0);
updatePlayBtn();
</script>
