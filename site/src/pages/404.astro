---
import LandingLayout from '../layouts/LandingLayout.astro';
import Nav from '../components/Landing/Nav.astro';
import Footer from '../components/Landing/Footer.astro';
---

<LandingLayout title="404 — Context Lost" description="The requested orchestration path does not exist.">
  <Nav />
  
  <main class="error-container">
    <div class="background-overlay"></div>
    
    <div class="content">
      <span class="error-code">404</span>
      <h1>Context Lost</h1>
      <p>The spec you are looking for has been purged or never existed. Our agents cannot find a valid path to this resource.</p>
      
      <div class="actions">
        <a href="/" class="btn-primary">Return to Base</a>
        <a href="/docs/getting-started" class="btn-secondary">View Docs</a>
      </div>
    </div>
  </main>

  <Footer />
</LandingLayout>

<style>
  .error-container {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    overflow: hidden;
    background: var(--color-bg);
  }

  .background-overlay {
    position: absolute;
    inset: 0;
    background: url('/images/404-bg.png') no-repeat center center;
    background-size: cover;
    opacity: 0.6;
    filter: blur(2px);
    z-index: 1;
  }

  .background-overlay::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 0%, rgba(0,0,0,0.8) 100%);
  }

  .content {
    position: relative;
    z-index: 2;
    max-width: 600px;
    animation: fadeIn 0.8s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .error-code {
    display: block;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
    letter-spacing: 0.2em;
    font-weight: 700;
    opacity: 0.8;
  }

  h1 {
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    background: linear-gradient(to bottom, var(--color-text), var(--color-text-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  p {
    font-size: 1.2rem;
    color: var(--color-text-secondary);
    margin-bottom: 3rem;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: var(--color-accent);
    color: var(--color-text);
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    transition: all 0.2s;
    border: 1px solid var(--color-accent);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .btn-secondary {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: transparent;
    color: var(--color-text);
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    transition: all 0.2s;
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-border-light);
    border-color: var(--color-text-secondary);
  }
</style>
