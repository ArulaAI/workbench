  "core_queries": [
    {
      "description": "List all defects with their current state, severity, and complexity",
      "traversal": "speed status --defects → lib/defects.sh::list_defects → .speed/defects/*/state.json",
      "answers": "What defects exist and what state is each in?"
    },
    {
      "description": "Retrieve triage classification and root cause hypothesis for a defect",
      "traversal": ".speed/defects/<name>/triage.json → complexity, affected_files, root_cause_hypothesis",
      "answers": "What did the Triage Agent determine about a specific defect?"
    },
    {
      "description": "Determine the pipeline path for a defect based on its complexity classification",
      "traversal": "triage.json::complexity → route_by_complexity → trivial(fix→integrate) | moderate(reproduce→fix→review→integrate) | complex(escalate)",
      "answers": "What stages will a defect go through and what human gates apply?"
    },
    {
      "description": "Check if a defect fix stayed within scope of affected files",
      "traversal": "git diff → check_grounding_gates → compare against triage.json::affected_files",
      "answers": "Did the fix modify only the files identified during triage?"
    }
  ]
